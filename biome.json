{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noEmptyInterface": "warn",
                "noConsole": "warn",
                "noUselessEscapeInString": "error",
                "noTsIgnore": "warn",
                "noUnusedExpressions": {
                    "level": "error"
                }
            },
            "style": {
                "useDestructuring": {
                    "level": "error",
                    "options": {
                        "variableDeclarator": {
                            "array": false
                        }
                    }
                }
            },
            "correctness": {
                "useJsxKeyInIterable": {
                    "level": "error",
                    "options": {
                        "checkShorthandFragments": true
                    }
                }
            }
        }
    },
    "javascript": {
        "globals": ["CoreManager"],
        "formatter": {
            "quoteStyle": "single",
            "quoteProperties": "asNeeded",
            "trailingCommas": "none",
            "semicolons": "always",
            "arrowParentheses": "always"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
