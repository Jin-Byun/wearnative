{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "composite": true,
    "types": ["node"],
    "outDir": "./lib",
    "rootDir": "./src",
    "resolveJsonModule": false,
  },
  "include": ["./src/**/*"],
  "exclude": [
    "./src/**/*.test.ts",
    "./lib/**/*",
    "./templateFiles/**/*",
    "node_modules",
    "../node_modules",
  ],
}
