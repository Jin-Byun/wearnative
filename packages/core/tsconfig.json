{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./lib",
    "rootDir": "./src",
    "resolveJsonModule": false,
    "baseUrl": ".",
    "paths": {
      "@tasks/*": ["src/tasks/*"],
      "@context/*": ["src/context/*"],
      "@api/*": ["src/api/*"],
      "@projects/*": ["src/projects/*"],
    },
  },
  "include": ["./src/**/*"],
  "exclude": ["./src/**/*.test.ts", "./lib/**/*", "./templateFiles/**/*"],
}
