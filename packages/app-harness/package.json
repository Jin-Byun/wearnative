{
    "name": "@rnv/app-harness",
    "version": "1.10.0-rc.1",
    "description": "ReNative Test Harness App",
    "keywords": [],
    "homepage": "https://github.com/flexn-io/renative#readme",
    "bugs": {
        "url": "https://github.com/flexn-io/renative/issues"
    },
    "license": "MIT",
    "author": "Pavel Jacko <pavel.jacko@gmail.com> (https://github.com/pavjacko)",
    "contributors": [],
    "repository": {
        "type": "git",
        "url": "git://github.com/flexn-io/renative.git"
    },
    "scripts": {
        "bootstrap": "cd ../.. && yarn bootstrap",
        "build:android-test": "npx rnv build -p android -s test -c harness --packageManager yarn --ci -r",
        "build:androidtv-test": "npx rnv build -p androidtv -s test -c harness --packageManager yarn --ci -r",
        "build:ios-test": "npx rnv build -p ios -s test -c harness --packageManager yarn --ci -r",
        "build:macos-test": "npx rnv build -p macos -s test -c harness --packageManager yarn --ci -r",
        "build:tvos-test": "npx rnv build -p tvos -s test -c harness --packageManager yarn --ci -r",
        "e2e:android": "APPIUM_HOME=./ PLATFORM=android JAVA_HOME=$(/usr/libexec/java_home) wdio wdio.conf.js",
        "e2e:androidtv": "APPIUM_HOME=./ PLATFORM=androidtv JAVA_HOME=$(/usr/libexec/java_home) wdio wdio.conf.js",
        "e2e:ios": "APPIUM_HOME=./ PLATFORM=ios wdio wdio.conf.js",
        "e2e:macos": "PLATFORM=macos ENGINE=electron wdio wdio.conf.js",
        "e2e:tvos": "APPIUM_HOME=./ PLATFORM=tvos wdio wdio.conf.js",
        "e2e:web": "PLATFORM=web wdio wdio.conf.js",
        "report": "yarn report:generate && yarn report:open",
        "report:generate": "npx allure generate --clean reporting/allure-results -o reporting/allure-report",
        "report:open": "npx allure open reporting/allure-report",
        "run:android-test": "npx rnv run -p android -s test -c harness --packageManager yarn --ci -r",
        "run:androidtv-test": "npx rnv run -p androidtv -s test -c harness --packageManager yarn --ci -r",
        "run:ios-test": "npx rnv run -p ios -s test -c harness --packageManager yarn --ci -r",
        "run:tvos-test": "npx rnv run -p tvos -s test -c harness --packageManager yarn --ci -r",
        "run:web-test": "npx rnv run -p web -s test -c harness --packageManager yarn --ci",
        "start:web-test": "npx rnv start -p web -s test -c harness --packageManager yarn --ci",
        "tsc": "tsc --noEmit --composite false",
        "watch": "tsc --watch --preserveWatchOutput --noEmit"
    },
    "dependencies": {
        "@react-native-community/cli": "catalog:",
        "@react-native-community/push-notification-ios": "1.11.0",
        "@react-native-firebase/app": "20.0.0",
        "@rnv/renative": "workspace:*",
        "dotenv": "16.4.5",
        "next": "catalog:",
        "raf": "catalog:",
        "react": "catalog:",
        "react-art": "catalog:",
        "react-dom": "catalog:",
        "react-native": "catalog:",
        "react-native-carplay": "2.3.0",
        "react-native-fs": "2.20.0",
        "react-native-gesture-handler": "catalog:",
        "react-native-google-cast": "4.8.3",
        "react-native-orientation-locker": "1.7.0",
        "react-native-permissions": "5.2.1",
        "@thienmd/react-native-image-editor": "0.7.0",
        "react-native-safe-area-context": "5.0.0",
        "react-native-splash-screen": "3.3.0",
        "react-native-tvos": "catalog:",
        "react-native-web": "catalog:",
        "rn-fetch-blob": "0.12.0"
    },
    "devDependencies": {
        "@flexn/assets-renative-outline": "catalog:",
        "@flexn/graybox": "catalog:",
        "@rnv/cli": "workspace:*",
        "@rnv/config-templates": "workspace:*",
        "@rnv/core": "workspace:*",
        "@rnv/engine-rn": "workspace:*",
        "@rnv/template-starter": "workspace:*",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/react-native": "catalog:",
        "babel-jest": "catalog:",
        "babel-loader": "catalog:",
        "detox": "catalog:",
        "react-player": "2.16.0"
    },
    "private": true,
    "browserslist": [
        ">0.2%",
        "op_mini all"
    ]
}
