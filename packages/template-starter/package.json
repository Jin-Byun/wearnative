{
    "name": "@rnv/template-starter",
    "version": "1.10.0-rc.1",
    "description": "🚧 Starter Template for wearNative `Android Wear`",
    "keywords": [
        "android wear",
        "watch"
    ],
    "homepage": "https://github.com/flexn-io/renative#readme",
    "bugs": {
        "url": "https://github.com/flexn-io/renative/issues"
    },
    "license": "MIT",
    "author": "Pavel Jacko <pavel.jacko@gmail.com> (https://github.com/pavjacko)",
    "contributors": [],
    "files": [
        ".gitignore",
        "Gemfile",
        "Gemfile.lock",
        "LICENSE",
        "README.md",
        "appConfigs/app/renative.json",
        "appConfigs/base/assets/runtime",
        "appConfigs/base/fonts",
        "appConfigs/base/renative.json",
        "babel.config.js",
        "buildHooks/src",
        "index.js",
        "metro.config.js",
        "react-native.config.js",
        "renative.json",
        "renative.template.json",
        "scripts",
        "src",
        "templateOverrides",
        "tsconfig.json",
        "typings",
        "webpack.config.js"
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/flexn-io/renative.git"
    },
    "scripts": {
        "build:android-test": "npx rnv build -p android -s test -c template --packageManager pnpm --ci -r",
        "e2e:android": "APPIUM_HOME=./ PLATFORM=android JAVA_HOME=$(/usr/libexec/java_home) wdio wdio.conf.js",
        "report": "pnpm report:generate && pnpm report:open",
        "report:generate": "npx allure generate --clean reporting/allure-results -o reporting/allure-report",
        "report:open": "npx allure open reporting/allure-report",
        "run:android-test": "npx rnv run -p android -s test -c template --packageManager pnpm --ci -r",
        "tsc": "tsc --noEmit --composite false",
        "watch": "tsc --watch --preserveWatchOutput --noEmit"
    },
    "devDependencies": {
        "@rnv/adapter": "workspace:*",
        "@rnv/cli": "workspace:*",
        "@rnv/config-templates": "workspace:*",
        "@rnv/core": "workspace:*",
        "@rnv/engine-rn": "workspace:*",
        "@rnv/renative": "workspace:*",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@types/react-native": "catalog:",
        "babel-loader": "catalog:",
        "detox": "catalog:",
        "next": "catalog:",
        "raf": "catalog:",
        "react": "catalog:",
        "react-art": "catalog:",
        "react-dom": "catalog:",
        "react-native": "catalog:",
        "react-native-gesture-handler": "catalog:",
        "react-native-tvos": "catalog:",
        "react-native-web": "catalog:"
    },
    "private": "false",
    "publishConfig": {
        "access": "public"
    },
    "browserslist": [
        ">0.2%",
        "op_mini all"
    ]
}
